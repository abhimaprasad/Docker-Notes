#Build Stage
FROM node:22 AS builder 
WORKDIR /nodeapp
COPY package*.json .
RUN npm install 
COPY . .
RUN npm run build 


#DEPLOY/FINAL STAGE
FROM nginx:alpine 
COPY --from=builder /nodeapp/dist /usr/share/nginx/html
COPY default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g","daemon off;"]

